---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  link?: { label: string; href: string };
}

const { eyebrow, title, description, link } = Astro.props;
---

<header class="section-heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {description && <p class="section-heading__description">{description}</p>}
  </div>
  {link && <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">→</span></a>}
</header>
