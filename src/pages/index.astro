---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WritingCard from '../components/WritingCard.astro';
import { featuredProjects } from '../data/projects';
import { writings } from '../data/writings';
import resumeHref from '../assets/files/daniel-markusson-resume.pdf';

const featuredWriting = writings.find((entry) => entry.slug === 'a-minimal-approach-to-fake-news-detection')!;
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__primary">
        <p class="eyebrow">Daniel Markusson · Toronto</p>
        <h1 class="hero-title" aria-label="I build software for RBC, for clients, and for fun.">
          <span class="hero-title__line" aria-hidden="true">
            <span class="hero-title__mask"><span class="hero-title__word">I</span></span>
            <span class="hero-title__mask"><span class="hero-title__word">build</span></span>
            <span class="hero-title__mask"><span class="hero-title__word">software</span></span>
          </span>
          <span class="hero-title__line" aria-hidden="true">
            <span class="hero-title__mask"><span class="hero-title__word">for</span></span>
            <span class="hero-title__mask"><span class="hero-title__word">RBC,</span></span>
          </span>
          <span class="hero-title__line" aria-hidden="true">
            <span class="hero-title__mask"><span class="hero-title__word">for</span></span>
            <span class="hero-title__mask"><span class="hero-title__word">clients,</span></span>
          </span>
          <span class="hero-title__line" aria-hidden="true">
            <span class="hero-title__mask"><span class="hero-title__word">and</span></span>
            <span class="hero-title__mask"><span class="hero-title__word">for</span></span>
            <span class="hero-title__mask"><span class="hero-title__word">fun.</span></span>
          </span>
        </h1>
        <p class="hero__lead">
          I’m a software developer at RBC and a Computer Science student at U of T. At RBC, I build reusable interface components and previously helped reduce a weekly API-proxy workflow by 83%. Outside work, I run a software creation agency and build projects in machine learning, robotics, and game AI.
        </p>
        <div class="button-row">
          <a class="button button--primary" href="/portfolio">View selected work</a>
          <a class="button button--quiet" href={resumeHref} target="_blank" rel="noreferrer">Download résumé</a>
        </div>
      </div>

      <aside class="hero__aside" aria-label="Current status">
        <p class="eyebrow">Currently</p>
        <p>Building reusable React components for RIG, RBC’s internal design framework.</p>
        <dl class="status-list">
          <div><dt>Work</dt><dd>Software Developer · RBC</dd></div>
          <div><dt>Study</dt><dd>Computer Science · U of T</dd></div>
          <div><dt>Based</dt><dd>Toronto, Canada</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="proof-strip" aria-label="Selected results">
    <div class="shell proof-strip__grid">
      <div class="proof"><strong>83%</strong><span>less time spent on a weekly RBC API-proxy workflow</span></div>
      <div class="proof"><strong>2×</strong><span>represented Canada at RoboCup Junior in France and Brazil</span></div>
      <div class="proof"><strong>71%</strong><span>test accuracy for a five-feature fake-news classifier</span></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected work"
        title="Selected software and engineering work."
        description="An RBC API-proxy dashboard, self-play bots for my family’s card game, and two generations of autonomous soccer robots."
        link={{ label: 'See all work', href: '/portfolio' }}
      />
      <div class="project-grid">
        {featuredProjects.map((project, index) => (
          <ProjectCard project={project} priority={index === 0} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell">
      <SectionHeading
        eyebrow="Research and writing"
        title="Machine learning, methodology, and philosophy."
        description="Published research on a five-feature XGBoost model, plus course papers on methodology and philosophy of religion."
        link={{ label: 'Browse all writing', href: '/writing' }}
      />
      <div class="writing-grid">
        <WritingCard writing={featuredWriting} featured />
        {writings.filter((entry) => entry.slug !== featuredWriting.slug).slice(0, 2).map((entry) => (
          <WritingCard writing={entry} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="shell about-preview">
      <div class="about-preview__image">
        <img
          src="/media/optimized/about/night-waterfront.webp"
          alt="Daniel standing by the Toronto waterfront at night."
          width="840"
          height="1050"
          loading="lazy"
        />
      </div>
      <div class="about-preview__copy">
        <p class="eyebrow">Beyond the résumé</p>
        <h2>I’m usually making something.</h2>
        <p>
          That might mean a robot, a wooden crossbow, or music on drums and bass. I also play basketball, train MMA, and lift.
        </p>
        <a class="text-link" href="/about">More about me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
