---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { featuredProjects, projects } from '../../data/projects';

const moreProjects = projects.filter((project) => !project.featured);
---

<BaseLayout
  title="Work — Daniel Markusson"
  description="Selected software, product, robotics, startup, and research work by Daniel Markusson."
>
  <header class="page-hero">
    <div class="shell page-hero__grid">
      <div>
        <p class="eyebrow">Work · 2022–present</p>
        <h1>Selected projects.</h1>
      </div>
      <p class="page-hero__intro">
        Projects from RBC, independent software, RoboCup, and machine-learning research.
      </p>
    </div>
  </header>

  <section class="section section--bordered">
    <div class="shell">
      <SectionHeading
        eyebrow="Featured"
        title="Three projects in detail."
        description="An RBC API tool, an online version of my family’s card game, and autonomous soccer robots."
      />
      <div class="project-grid">
        {featuredProjects.map((project, index) => <ProjectCard project={project} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell">
      <SectionHeading
        eyebrow="More work"
        title="A few more."
        description="My first RBC internship, Shredr, and a six-month fake-news research project."
      />
      <div class="project-grid">
        {moreProjects.map((project) => <ProjectCard project={project} compact />)}
      </div>
    </div>
  </section>
</BaseLayout>
