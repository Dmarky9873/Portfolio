---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingCard from '../../components/WritingCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { writings } from '../../data/writings';

const featured = writings.find((entry) => entry.slug === 'a-minimal-approach-to-fake-news-detection')!;
const essays = writings.filter((entry) => entry.slug !== featured.slug);
---

<BaseLayout
  title="Writing — Daniel Markusson"
  description="Research and essays by Daniel Markusson on machine learning, evidence, methodology, and religious experience."
>
  <header class="page-hero">
    <div class="shell page-hero__grid">
      <div>
        <p class="eyebrow">Writing · Research and essays</p>
        <h1>Research and course papers.</h1>
      </div>
      <p class="page-hero__intro">
        Five papers on fake-news detection, philosophy of religion, research methods, and religious experience.
      </p>
    </div>
  </header>

  <section class="section section--bordered">
    <div class="shell">
      <SectionHeading
        eyebrow="Featured research"
        title="A minimal approach to fake-news detection."
        description="A five-feature XGBoost model, published after six months of independent research."
      />
      <div class="writing-grid"><WritingCard writing={featured} featured /></div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected essays"
        title="Philosophy and religious studies."
        description="Four course papers, each with a short summary and the original PDF."
      />
      <div class="writing-grid">
        {essays.map((entry) => <WritingCard writing={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>
