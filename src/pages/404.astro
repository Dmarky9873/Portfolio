---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Daniel Markusson" description="The requested page could not be found." noindex>
  <section class="not-found">
    <div class="shell">
      <p class="eyebrow">That route does not exist</p>
      <h1>404</h1>
      <p>The page may have moved, or the link may be incomplete. The work and writing archives are still right where they should be.</p>
      <div class="button-row" style="justify-content:center">
        <a class="button button--primary" href="/">Go home</a>
        <a class="button button--quiet" href="/portfolio">Browse work</a>
      </div>
    </div>
  </section>
</BaseLayout>
